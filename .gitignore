# macOS
.DS_Store
.AppleDouble
.LSOverride

# Obsidian
.obsidian/

# Personal vault content — never commit your actual notes
# (root-level only, vault-template/ is still tracked)
/wiki/
/raw/
/outputs/
*.last_ingest_run

# Allow vault-template contents
!vault-template/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# Logs
*.log
ingest-daemon.log
graphify-out/

# Secrets — never commit (keys live in VPS ~/.hermes/*/.env, gitignored)
.env
*.env
.secondbrain.env
.frag
*.bak.*

# Local agent/tooling dirs (not project code)
.agents/
# (.claude/* not .claude/ — git cannot re-include a path whose parent dir is excluded)
.claude/*
# ...except project skills, which ARE project code — they are how an agent working
# in this repo discovers the ingest paths without rediscovering them each session.
!.claude/skills/
skills-lock.json
.playwright-mcp/
